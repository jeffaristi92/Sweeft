<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Sweeft.Core\Sweeft.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <AssemblyName>sweeft</AssemblyName>
    <Product>Sweeft</Product>
    <Company>Jeffersoft</Company>
    <Version>1.0.0</Version>
    <Description>Sweeft — a Jeffersoft tool. Detects build/dependency folders and old, heavy files to free up disk space.</Description>
    <Authors>Yeferson Guarin (Jeffersoft)</Authors>

    <!-- NativeAOT: the analyzers stay on here; the actual native build is enabled
         via `-p:PublishAot=true` in the release workflow, so `dotnet pack` (the
         .NET global tool) is unaffected. -->
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>

    <!-- .NET global tool: `dotnet tool install -g Sweeft` -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sweeft</ToolCommandName>
    <PackageId>Sweeft</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jeffaristi92/Sweeft</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jeffaristi92/Sweeft</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>cli;cleanup;disk-space;node_modules;bin;obj;dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
